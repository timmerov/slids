/*
electoral method base class.
*/

import slids.linpro;
import slids.map;
import slids.string;
import slids.vector;
import candidate;
import settings;

/*
base class for electoral methods.
every derived class must define find_winner.
*/
ElectoralMethod(
    slids:String name_,
    int winner_ = -1,
    int is_winner_ = 0,
    float64 total_utility_ = 0.0,
    float64 satisfaction_ = 0.0,
    float64 correlation_ = 0.0,
    int nvillains_ = 0,
    int nminions_ = 0
) {
    const int kWidth = 30;
    global int g_nmethods = 0;

    _();
    virtual ~();

    /* find the winner. */
    virtual void find_winner(bool quiet = kQuiet) = delete;

    /* pretty print the winner. */
    virtual void print_winner();

    /* calculate satisfaction and correlation. */
    void calculate_results();

    /* pretty print satisfaction. */
    virtual void print_satisfaction();

    /* pretty print correlation. */
    virtual void print_correlation();

    /* analyze strategic voting. */
    virtual void strategic_voting();

    /* pretty print strategic voting summary. */
    virtual void print_strategic_results();
}
alias ElectoralMethods = slids:Vector<ElectoralMethod^>;

/* calculate satisfaction from utility and metrics. */
float64 calculate_satisfaction(float64 utility, SatisfactionMetrics^ metric);

/* if winner is expected then "pass" otherwise "=FAIL=" or "n/a". */
(const char)[] result_to_string(int winner, int expected);

/*
helpers shared by the electoral methods.
*/

/*
convert candidate rankings to voting schedule.
*/
SizeVar(
    int size_,
    slids:LP:Var var_
) {
}
alias ScheduleMap = slids:Map<Rankings, SizeVar>;
slids {
    MapNode<Key=Rankings, Value=SizeVar>(
        alias schedule_ = key_,
        alias sv_ = value_
    ) {
    }
}

RankedChoice(
    Rankings rankings_,
    int size_
) {
}
alias RankedChoices = slids:Vector<RankedChoice>;

/* the number of votes A can surrender and still beat B. */
int victory_margin(int a, int b, int votesa, int votesb);

/* the number of votes A can gain and still lose to B. */
int loss_margin(int a, int b, int votesa, int votesb);

/* cycle through all possible permutations. */
bool permute(slids:Vector<int>^ order, int n = -1);

/* convert rankings to voting schedule given an elimination order. */
Rankings rankings_to_schedule(Rankings^ rankings, Rankings^ elimination_order);

/* convert rankings to last-first voting schedule given an elimination order. */
Rankings rankings_to_last_first_schedule(Rankings^ rankings, Rankings^ elimination_order);

/* breaking ties in linear programming. */
slids:LP:Comparison gt_or_gte(int a, int b);
slids:LP:Comparison lt_or_lte(int a, int b);
