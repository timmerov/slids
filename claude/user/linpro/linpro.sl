/*
linear programming solver.

the test case is strategic plurality runoff voting.
there are:
- 4 candidates ABCD.
- up to 4! voter blocs with honest rankings.
- 1000 total voters.
find the minimum number of strategic voters who can change
the results to a higher ranked candidate.

data is generated by the guthrie voting test harness.
*/

import+ algorithm;
import string;
import+ vector;
import votedata;
alias slids;

Candidate(
    char name_ = '\0',
    int number_ = 0,
    int votes_ = 0
) {
    /* for sorting in descending order. */
    bool op<(Candidate^ rhs) {
        if (votes_ > rhs^.votes_) {
            return true;
        }
        if (votes_ < rhs^.votes_) {
            return false;
        }
        return (number_ < rhs^.number_);
    }
}
alias Candidates = Vector<Candidate>;

LinPro(
    int ncandidates_ = 0,
    BlocMap bloc_map_,
    Candidates candidates_,
    Candidates sorted_,
    int winner_ = 0
) {
    void run() {
        init();
        if (ncandidates_ == 0) {
            return;
        }

        print_bloc_map();
        count_votes();
        sort_candidates();
        winner_ = sorted_[0].number_;
        print_votes(candidates_);
        print_votes(sorted_);
        print_pairwise();

        find_all_strategies();
    }

    void init() {
        bloc_map_ = get_voter_data();
        if (bloc_map_.size() == 0) {
            println("Failed to get voter data.");
            return;
        }

        it = bloc_map_.begin();
        ncandidates_ = (int=it^.rankings_.size());
        println(String + "ncandidates: " + ncandidates_);

        candidates_.resize(ncandidates_);
        for (i : 0..ncandidates_) {
            ch char = 'A' + i;
            candidate = ^candidates_[i];
            candidate^.name_ = ch;
            candidate^.number_ = i;
        }
    }

    void print_bloc_map() {
        println("Voting blocs:");
        for (it : bloc_map_) {
            s = to_string(it^.rankings_);
            println(String + " " + s + ": " + it^.size_);
        }
    }

    void count_votes() {
        /* zero counts. */
        for (candidate : candidates_) {
            candidate^.votes_ = 0;
        }

        /* add the blocs */
        for (it : bloc_map_) {
            which = it^.rankings_[0];
            candidate = ^candidates_[which];
            candidate^.votes_ += it^.size_;
        }
    }

    void sort_candidates() {
        sorted_ = candidates_;
        quicksort(sorted_);
    }

    void print_votes(
        Candidates^ candidates
    ) {
        println("Vote totals:");
        for (candidate : candidates^) {
            println(String + " " + candidate^.name_ + ": " + candidate^.votes_);
        }
    }

    void print_pairwise() {

        Vector<int> wins;
        wins.resize(ncandidates_);
        for (ptr^ : wins) {
            ptr^ = 0;
        }

        println("Head to head:");
        for (a : 0..ncandidates_) {
            for (b : (a+1)..ncandidates_) {
                /* count votes who rank a>b and b>a. */
                counta = 0;
                countb = 0;
                for (it : bloc_map_) {
                    for (which : it^.rankings_) {
                        if (which == a) {
                            counta += it^.size_;
                            break;
                        }
                        if (which == b) {
                            countb += it^.size_;
                            break;
                        }
                    }
                }

                /* print so lhs always wins. */
                canda = ^candidates_[a];
                candb = ^candidates_[b];
                if (counta < countb) {
                    canda <--> candb;
                    counta <--> countb;
                }
                println(String + " " + canda^.name_ + " (" + counta + ") > " + candb^.name_ + " (" + countb + ")");

                /* record the win. */
                wins[canda^.number_]++;
            }
        }

        println("Wins:");
        for (i : 0..ncandidates_) {
            name = candidates_[i].name_;
            println(String + " " + name + ": " + wins[i]);
        }
    }

    void find_all_strategies() {
        for (a : 0..ncandidates_) {
            if (a == winner_) {
                continue;
            }
            find_strategy(a);
        }
    }

    void find_strategy(int a) {
        namea char = candidates_[a].name_;
        namew char = candidates_[winner_].name_;
        println(String + "Looking for strategy for " + namea + ">" + namew + ":");

        votesa = 0;
        votesw = 0;
        coalition_size = 0;
        for (it : bloc_map_) {
            choice = it^.rankings_[0];
            bloc_name = to_string(it^.rankings_);
            bloc_name = bloc_name + " (" + it^.size_ + ")";

            /* voters for the winner do not vote strategically. */
            if (choice == winner_) {
                println(String + " " + bloc_name + " won.");
                votesw += it^.size_;
                continue;
            }

            /* A voters have no other strategy. */
            if (choice == a) {
                println(String + " " + bloc_name + " voted for " + namea + ".");
                votesa += it^.size_;
                continue;
            }

            /* find voters who prefer A>winner. */
            for (preference : it^.rankings_) {
                if (preference == winner_) {
                    println(String + " " + bloc_name + " prefer " + namew + ">" + namea + ".");
                    continue next_bloc;
                }
                if (preference == a) {
                    println(String + " " + bloc_name + " should vote strategically.");
                    break;
                }
            }

            /* add to the coalition. */
            coalition_size += it^.size_;
        } : next_bloc;

        println(String + " votes winner     " + namew + ": " + votesw);
        println(String + " votes challenger " + namea + ": " + votesa);
        println(String + " coalition size    : " + coalition_size);
    }
}

/*
linear programming solver.
*/
LP(
    int nuser_vars_,
    VarList vars_,
    Columns cols_,
    Rows rows_
) {
    _() {
        /* add the column for constants. */
        z = add_var("Z", false);

        /* add the cost row. */
        Expr expr;
        expr.constant_ = 0;
        expr.relation_ = kGTE;
        add_row(z, expr);
    }
    ~() {
    }

    /* returned to the author. */
    Var(int idx_) { }

    /* variable's idx name value. */
    VarInfo(
        int idx_,
        int value_,
        bool user_,
        String name_
    ) {
    }
    alias VarList = Vector<VarInfo>;

    /* every column is owned by a variable. */
    Column(
        int owner_
    ) {
    }
    alias Columns = Vector<Column>;

    /* coefficients are rational numbers. */
    Rational(
        int numer_ = 0,
        int denom_ = 1
    ) {
        int ivalue() {
            return (int=fvalue());
        }
        float64 fvalue() {
            n float64 = numer_;
            d float64 = denom_;
            return n / d;
        }
        op=(int rhs) {
            numer_ = rhs;
            denom_ = 1;
        }
        op+=(int rhs) {
            self += Rational(rhs);
        }
        op-=(int rhs) {
            self += - rhs;
        }
        op+=(Rational^ rhs) {
            n int64 = numer_;
            d int64 = denom_;
            n = n * rhs^.denom_ + d * rhs^.numer_;
            d = d * rhs^.denom_;
            reduce(n, d);
        }
        op-=(Rational^ rhs) {
            self += - rhs^;
        }
        op*=(Rational^ rhs) {
            n int64 = numer_;
            d int64 = denom_;
            n *= rhs^.numer_;
            d *= rhs^.denom_;
            reduce(n, d);
        }
        op/=(Rational^ rhs) {
            self *= rhs^.reciprocal();
        }
        op-(Rational^ rhs) {
            numer_ = - rhs^.numer_;
            denom_ = rhs^.denom_;
        }
        Rational reciprocal() {
            Rational x;
            x.numer_ = denom_;
            x.denom_ = numer_;
            return x;
        }
        void reduce(int64 n, int64 d) {
            if (d != 1) {
                /* find gcd. */
                a = n;
                b = d;
                while (b) {
                    r = a % b;
                    a = b;
                    b = r;
                }
                if (a < 0) {
                    a = - a;
                }
                n /= a;
                d /= a;
            }
            numer_ = (int=n);
            denom_ = (int=d);
        }
    }

    /* a term is a variable index and its coefficient. */
    Term(
        int var_idx_,
        Rational coeff_
    ) { }
    alias Terms = Vector<Term>;

    /*
    every row is owned by a variable, has a constant,
    and a list of terms.
    */
    Row(
        int owner_,
        Rational constant_,
        Terms terms_
    ) {
    }
    alias Rows = Vector<Row>;

    /* inequality relation classes and enum. */
    enum Relation (kErr, kLT, kGT, kLTE, kGTE);
    Comparison(Relation relation_ = kErr) { }
    Comparison : lt() {
        _() {
            relation_ = kLT;
        }
        ~() { }
    }
    Comparison : gt() {
        _() {
            relation_ = kGT;
        }
        ~() { }
    }
    Comparison : lte() {
        _() {
            relation_ = kLTE;
        }
        ~() { }
    }
    Comparison : gte() {
        _() {
            relation_ = kGTE;
        }
        ~() { }
    }

    /* an expression is how we build a row. */
    Expr(
        Rational constant_,
        Relation relation_ = kErr,
        Terms terms_
    ) {
        op+=(int rhs) {
            if (relation_ == kErr) {
                constant_ += rhs;
            } else {
                constant_ -= rhs;
            }
        }
        op-=(int rhs) {
            self += - rhs;
        }
        op+=(Var^ rhs) {
            term = terms_.append();
            term^.var_idx_ = rhs^.idx_;
            term^.coeff_ = 1;
            if (relation_ != kErr) {
                term^.coeff_ = -1;
            }
        }
        op-=(Var^ rhs) {
            term = terms_.append();
            term^.var_idx_ = rhs^.idx_;
            term^.coeff_ = -1;
            if (relation_ != kErr) {
                term^.coeff_ = 1;
            }
        }
        op+=(Comparison^ rhs) {
            if (relation_ != kErr) {
                println("**Error** expression has multiple comparison operations.");
            }
            relation_ = rhs^.relation_;
        }
    }

    /* print the matrix. */
    void print() {
        nrows int = rows_.size();
        String s;

        /* find the width of the row index numbers. */
        idx_width = 0;
        for (i : 0..nrows) {
            s = i;
            len int = s.size();
            idx_width = math:max(idx_width, len);
        }
        Format xfmt;
        xfmt.min_width_ = idx_width;

        /* find the width of the variable names. */
        name_width = 0;
        for (var : vars_) {
            s = String + var^.name_;
            len int = s.size();
            name_width = math:max(name_width, len);
        }
        Format nfmt;
        nfmt.min_width_ = name_width;

        /* find the needed precision. */
        precision = 0;
        for (row : rows_) {
            int get_precision(int denom) {
                switch (denom) {
                    /* integer */
                    1: { return 0; }
                    /* these need only a single digit. */
                    2: 5: 10: { return 1; }
                    /* everything else is truncated to 2 digits. */
                    default: { return 2; }
                }
            }
            prec = get_precision(row^.constant_.denom_);
            precision = math:max(precision, prec);
            if (precision >= 2) {
                break precision_loop;
            }
            for (term : row^.terms_) {
                prec = get_precision(term^.coeff_.denom_);
                precision = math:max(precision, prec);
                if (precision >= 2) {
                    break precision_loop;
                }
            }
        } :precision_loop;
        Format cfmt;
        cfmt.float_style_ = kFixedPoint;
        cfmt.precision_ = precision;

        /* find the width of the constants. */
        coeff_width = 0;
        for (row : rows_) {
            int get_string_length(Rational^ x) {
                konst = x^.fvalue();
                ss = cfmt*konst;
                slen int = ss.size();
                return slen;
            }
            /* constants are signed. */
            len = get_string_length(row^.constant_);
            coeff_width = math:max(coeff_width, len);
            for (term : row^.terms_) {
                /* exclude the coefficient sign. */
                x = term^.coeff_;
                x.numer_ = math:abs(x.numer_);
                len = get_string_length(x);
                coeff_width = math:max(coeff_width, len);
            }
        }
        cfmt.justify_ = kRightJustify;
        cfmt.min_width_ = coeff_width;

        /* print the column headers. */
        s.clear();
        s = xfmt*"" + "  " + nfmt*"" + "   " + cfmt*"";
        for (col : cols_) {
            owner = col^.owner_;
            name = ^vars_[owner].name_;
            s = s + "   " + cfmt*name^;
        }
        println(s);

        /* print the rows. */
        for (i : 0..nrows) {
            row = ^rows_[i];
            owner = row^.owner_;
            konst = row^.constant_.fvalue();
            name = ^vars_[owner].name_;
            s = String + xfmt*i + ": " + nfmt*name^ + " = " + cfmt*konst;
            for (term : row^.terms_) {
                if (term^.coeff_.numer_) {
                    coeff = term^.coeff_.fvalue();
                    owner = term^.var_idx_;
                    name = ^vars_[owner].name_;
                    sign = "+";
                    if (coeff < 0.0) {
                        coeff = - coeff;
                        sign = "-";
                    }
                    s = s + " " + sign + " " + cfmt*coeff;
                } else {
                    s = s + "   " + cfmt*"";
                }
            }
            println(s);
        }
    }

    /* add a user variable. */
    Var add_var(String^ name) {
        return add_var(name, true);
    }

    /* add a user variable. */
    Var add_var(String^ name, bool user) {
        idx int = vars_.size();
        vi = vars_.append();
        vi^.idx_ = idx;
        vi^.user_ = user;
        vi^.value_ = 0;
        vi^.name_ = name^;

        if (user) {
            if (rows_.size() > 1) {
                println("**Error** add variables before adding rows.");
            }

            ++nuser_vars_;

            /* add user var to z row. */
            term = rows_[0].terms_.append();
            term^.var_idx_ = idx;
            term^.coeff_ = 1;

            /* add user var to columns. */
            col = cols_.append();
            col^.owner_ = idx;
        }

        return Var(idx);
    }

    /* add a user row. */
    void add_row(
        Expr^ expr
    ) {
        nrows int = rows_.size();
        name = String + "R" + nrows;
        row_var = add_var(name, false);
        add_row(row_var, expr);
    }

    /* add a row. */
    void add_row(
        Var^ var,
        Expr^ expr
    ) {
        Row^ row = rows_.append();
        row^.owner_ = var^.idx_;
        row^.constant_ = expr^.constant_;
        row^.terms_.reserve(nuser_vars_);

        /* init the terms. */
        for (var : vars_) {
            if (var^.user_ == false) {
                continue;
            }
            term = row^.terms_.append();
            term^.var_idx_ = var^.idx_;
            term^.coeff_ = 0;
        }

        /* copy the terms from the expr to the row. */
        for (var_term : expr^.terms_) {
            var_idx = var_term^.var_idx_;
            for (row_term : row^.terms_) {
                if (row_term^.var_idx_ == var_idx) {
                    row_term^.coeff_ += var_term^.coeff_;
                    break;
                }
            }
        }

        /* convert less-than rows. */
        rel = expr^.relation_;
        if (rel == kLT || rel == kLTE) {
            row^.constant_ = - row^.constant_;
            for (row_term : row^.terms_) {
                row_term^.coeff_ = - row_term^.coeff_;
            }
            if (rel == kLT) {
                rel = kGT;
            } else {
                rel = kGTE;
            }
        }

        /* convert greater-than rows. */
        if (rel == kGT) {
            row^.constant_ -= 1;
        }
    }

    /* find a solution. */
    void solve() {
        nrows int = rows_.size();

        for (iter = 0) () {++iter;} {
            //println(String + "iteration " + iter);

            /* find the row with the most negative constant. */
            pivot_row_idx = -1;
            min_konst float64 = 0.0;
            for (i : 0..nrows) {
                row = ^rows_[i];
                konst = row^.constant_.fvalue();
                if (min_konst > konst) {
                    pivot_row_idx = i;
                    min_konst = konst;
                }
            }
            if (min_konst >= 0.0) {
                //println("no rows have a negative constant.");
                break iter_loop;
            }
            //println(String + "row " + pivot_row_idx + " has the most negative constant " + min_konst);

            /*
            find the pivot:
            - row coefficient is positive.
            - minimizes Z/K ratio.
            */
            rowz = ^rows_[0];
            row = ^rows_[pivot_row_idx];
            nterms int = row^.terms_.size();
            pivot_col_idx = -1;
            float64 min_ratio = 0.0;
            for (col_idx : 0..nterms) {
                term = ^row^.terms_[col_idx];
                konst = term^.coeff_.fvalue();
                if (konst <= 0.0) {
                    continue;
                }
                termz = ^rowz^.terms_[col_idx];
                konstz = termz^.coeff_.fvalue();
                ratio = konstz / konst;
                if (pivot_col_idx < 0 || ratio < min_ratio) {
                    pivot_col_idx = col_idx;
                    min_ratio = ratio;
                }
            }
            if (pivot_col_idx < 0) {
                //println("no positive coefficients found.");
                break iter_loop;
            }
            //println(String + "pivot is column " + pivot_col_idx + " minimum ratio " + min_ratio);

            factor = - row^.terms_[pivot_col_idx].coeff_.reciprocal();
            //println(String + "multiply row " + pivot_row_idx + " by factor " + factor.fvalue());
            row^.constant_ *= factor;
            for (term : row^.terms_) {
                term^.coeff_ *= factor;
            }
            //print();

            for (row_idx : 0..nrows) {
                if (row_idx == pivot_row_idx) {
                    continue;
                }

                rowi = ^rows_[row_idx];
                scale = rowi^.terms_[pivot_col_idx].coeff_;
                //println(String + "multiply row " + pivot_row_idx + " by " + scale.fvalue() + " add to row " + row_idx);

                rowi^.constant_ = row^.constant_ * scale + rowi^.constant_;
                for (col_idx : 0..nterms) {
                    term = ^row^.terms_[col_idx];
                    termi = ^rowi^.terms_[col_idx];
                    termi^.coeff_ = term^.coeff_ * scale + termi^.coeff_;
                }
                //print();

                //println(String + "replace row " + row_idx + " column " + pivot_col_idx + " coefficient");
                termi = ^rowi^.terms_[pivot_col_idx];
                termi^.coeff_ = - factor * scale;
                //print();
            }

            //println(String + "replace pivot row " + pivot_row_idx + " column " + pivot_col_idx + " coefficient");
            row^.terms_[pivot_col_idx].coeff_ = - factor;
            //print();

            //println(String + "swap row column owners.");
            col_owner = row^.owner_;
            row^.owner_ <--> cols_[pivot_col_idx].owner_;
            for (rowi : rows_) {
                rowi^.terms_[pivot_col_idx].var_idx_ = col_owner;
            }
            //print();
        } :iter_loop;
    }
}

int32 main() {

    LP lp;
    xa = lp.add_var("XA");
    xb = lp.add_var("XB");
    ab = lp.add_var("AB");
    ba = lp.add_var("BA");
    a = 90;
    b = 80;
    w = 100;
    x = 200;
    baw = 40;
    xaw = 150;
    /* a beats w and x. */
    row0 = LP:Expr + a - ab + ba + xa + LP:gte + w;
    row1 = LP:Expr + a - ab + ba + xa + LP:gte + x - xa - xb;
    /* b beats w and x. */
    row2 = LP:Expr + b + ab - ba + xb + LP:gte + w;
    row3 = LP:Expr + b + ab - ba + xb + LP:gte + x - xa - xb;
    /* limit x to a,b votes. */
    row4 = LP:Expr + xa + xb + LP:lte + xaw;
    /* limit a to b votes. */
    row5 = LP:Expr + ab + LP:lte + a;
    /* limit b to a votes. */
    row6 = LP:Expr + ba + LP:lte + baw;
    /* =tsc= to do: break ties. */
    /* add the rows. */
    lp.add_row(row0);
    lp.add_row(row1);
    lp.add_row(row2);
    lp.add_row(row3);
    lp.add_row(row4);
    lp.add_row(row5);
    lp.add_row(row6);
    println("initial matrix:");
    lp.print();
    lp.solve();
    println("solved matrix:");
    lp.print();

    ab; ba; xa; xb;
    a; b; w; x;
    baw; xaw;
    //row0; row1; row2; row3; row4; row5; row6;

/*
    LinPro linpro;
    linpro.run();
*/
    return 0;
}

/*
okay so this has become a method matrix generator.
for plurality:
A wins when:
    ABC + ACB > BAC + BCA
    ABC + ACB > CAB + CBA
B wins when:
    BAC + BCA > ABC + ACB
    BAC + BCA > CAB + CBA
C wins when:
    CAB + CBA > ABC + ACB
    CAB + CBA > BAC + BCA
A wins strategically over B when:
    BAC + BCA > ABC + ACB
    BAC + BCA > CAB + CBA
    ABC + kCAB_ABC + ACB + kCAB_ACB + > BAC + BCA
    ABC + ACB > CAB - kCAB_ABC - kCAB_ACB + CBA
    kCAB_ABC + kCAB_ACB <= CAB
    kCAB_ABC >= 0
    kCAB_ACB >= 0
similarly for A>C, B>A, B>C, C>A, C>B. whew.
maximum of N! blocs.
maximum of N! * N!-1 manipulation variables kXXX_YYY.
minimize sum k's.

should we do all X wins matrices?
and all of the X wins over Y manipulation matrices?
or should we do one of each and permute the bloc identities?

the original plan was plurality voting.
that's too easy.
there's a simple closed form solution.
pivot to plurality runoff voting.
there's also a closed form solution for any given number of candidates.
the general solution is less than obvious.
it's complex enough to use tools.
specifically the dual simplex method of linear programming.
claude says read gnu's glpk source:
https://github.com/firedrakeproject/glpk/tree/master/src/simplex

4 candidates: winner W, thief A, stooge B, other X.
human readable equations:

R1:   XA        − AB + BA > W - A = -K1
R2: 2 XA +   XB − AB + BA > X - A = -K2
R3:          XB + AB − BA > W - B = -K3
R4:   XA + 2 XB + AB − BA > X - B = -K4
C5:   XA +   XB           < XAW   =  K5
C6:               AB      < A     =  K6
C7:                    BA < BAW   =  K7
Z:    XA +   XB + AB + BA > 0     =  KZ

note: i'm being sloppy about > or >= or < or <=.

R1: A votes > W votes
R2: A votes > X votes
R3: B votes > W votes
R4: B votes > X votes
C5: X votes shifted to A,B limited by X voters who prefer A>W.
C6: A votes shifted to B limited by A votes.
C7: B votes shifted to A limited by B voters who prefer A>W.
Z: quantity to minimize.

transform equations to normal form:

R1: K1 +   XA        − AB + BA > 0
R2: K2 + 2 XA +   XB − AB + BA > 0
R3: K3        +   XB + AB − BA > 0
R4: K4 +   XA + 2 XB + AB − BA > 0
C5: K5 -   XA -   XB           > 0
C6: K6               - AB      > 0
C7: K7                    - BA > 0
Z:  KZ +   XA +   XB + AB + BA > 0

every row names a variable.
every column names a variable.
initially the rows are slack variables that balance the inequality.
initially the columns are user variables.

find most negative Kn in row R.
- KZ is never negative so may be excluded from the search.
pick one of the columns with a positive coefficient C.
literature says minimum ratio: ZC/RC
- or max RC/ZC - caution ZC can be 0.
if there is no such C then fail - there is no solution.
solve the row for C producing equation E.
replace row R with E.
swap the names of the row and column.
substitute C into all other rows (including Z).

repeat with next negative Kn.
when there are no negative Kn left, we're almost done.
KZ is the optimal solution.
for rows owned by a user value Un, its value is Kn.
otherwise Un = 0

some of the Un may be fractional.
in which case we need to add one of two branches.
branch 1: Un <= floor Kn
branch 2: Un >= ceil Kn
substitute Rn for Un in these equations.
get a solution for branch 1.
the newly added row is the first pivot - no need to search.
recurse if there are more fractional Un.
eventually you land on a solution or fail.
backtrack trying the other branches.
Z only increases as you descend.
prune paths that are infeasible or worse than the current best.
- Z can be fractional. so prune when ceil Z >= best.

some nits:
all of the Z coefficients can't be negative.
the implementation might want to put Z in row 0.

possible syntax:

LinPro lp;
ab = lp.var("AB");
ba = lp.var("BA");
xa = lp.var("XA");
xb = lp.var["XB");
row1 = LP:Expr + votesa + xa - ab + ba + LP:gt + votesw;
row2 = LP:Expr + votesa + xa - ab + ba + LP:gt + votesx - xa - xb;
lp.append(row1);
lp.append(row2);
if (!lp) {
    println(lp.error_string());
}

LinPro(Vector<VarInfo> vars, Vector<Terms> rows) { }
LP:Var(int idx) { }
LP:Expr(Vector<TermInfo>) {
    enum ( lt, gt, lte, gte );
    op+ op- op* op/ () { }
}
