/*
linear programming solver.

the test case is strategic plurality voting.
there are:
- 4 candidates ABCD.
- up to 4! voter blocs with honest rankings.
- 1000 total voters.
find the minimum number of strategic voters who can change
the results to a higher ranked candidate.

data is generated by the guthrie voting test harness.
*/

import+ algorithm;
import string;
import+ vector;
import votedata;
alias slids;

Candidate(
    char name_ = '\0',
    int number_ = 0,
    int votes_ = 0
) {
    /* for sorting in descending order. */
    bool op<(Candidate^ rhs) {
        if (votes_ > rhs^.votes_) {
            return true;
        }
        if (votes_ < rhs^.votes_) {
            return false;
        }
        return (number_ < rhs^.number_);
    }
}
alias Candidates = Vector<Candidate>;

LinPro(
    int ncandidates_ = 0,
    BlocMap bloc_map_,
    Candidates candidates_,
    Candidates sorted_,
    int winner_ = 0
) {
    void run() {
        init();
        if (ncandidates_ == 0) {
            return;
        }

        print_bloc_map();
        count_votes();
        sort_candidates();
        winner_ = sorted_[0].number_;
        print_votes(candidates_);
        print_votes(sorted_);
        print_pairwise();

        find_all_strategies();
    }

    void init() {
        bloc_map_ = get_voter_data();
        if (bloc_map_.size() == 0) {
            println("Failed to get voter data.");
            return;
        }

        it = bloc_map_.begin();
        ncandidates_ = (int=it^.rankings_.size());
        println(String + "ncandidates: " + ncandidates_);

        candidates_.resize(ncandidates_);
        for (i : 0..ncandidates_) {
            ch char = 'A' + i;
            candidate = ^candidates_[i];
            candidate^.name_ = ch;
            candidate^.number_ = i;
        }
    }

    void print_bloc_map() {
        println("Voting blocs:");
        for (it : bloc_map_) {
            s = to_string(it^.rankings_);
            println(String + " " + s + ": " + it^.size_);
        }
    }

    void count_votes() {
        /* zero counts. */
        for (candidate : candidates_) {
            candidate^.votes_ = 0;
        }

        /* add the blocs */
        for (it : bloc_map_) {
            which = it^.rankings_[0];
            candidate = ^candidates_[which];
            candidate^.votes_ += it^.size_;
        }
    }

    void sort_candidates() {
        sorted_ = candidates_;
        quicksort(sorted_);
    }

    void print_votes(
        Candidates^ candidates
    ) {
        println("Vote totals:");
        for (candidate : candidates^) {
            println(String + " " + candidate^.name_ + ": " + candidate^.votes_);
        }
    }

    void print_pairwise() {

        Vector<int> wins;
        wins.resize(ncandidates_);
        for (ptr^ : wins) {
            ptr^ = 0;
        }

        println("Head to head:");
        for (a : 0..ncandidates_) {
            for (b : (a+1)..ncandidates_) {
                /* count votes who rank a>b and b>a. */
                counta = 0;
                countb = 0;
                for (it : bloc_map_) {
                    for (which : it^.rankings_) {
                        if (which == a) {
                            counta += it^.size_;
                            break;
                        }
                        if (which == b) {
                            countb += it^.size_;
                            break;
                        }
                    }
                }

                /* print so lhs always wins. */
                canda = ^candidates_[a];
                candb = ^candidates_[b];
                if (counta < countb) {
                    canda <--> candb;
                    counta <--> countb;
                }
                println(String + " " + canda^.name_ + " (" + counta + ") > " + candb^.name_ + " (" + countb + ")");

                /* record the win. */
                wins[canda^.number_]++;
            }
        }

        println("Wins:");
        for (i : 0..ncandidates_) {
            name = candidates_[i].name_;
            println(String + " " + name + ": " + wins[i]);
        }
    }

    void find_all_strategies() {
        for (a : 0..ncandidates_) {
            if (a == winner_) {
                continue;
            }
            find_strategy(a);
        }
    }

    void find_strategy(int a) {
        namea char = candidates_[a].name_;
        namew char = candidates_[winner_].name_;
        println(String + "Looking for strategy for " + namea + ">" + namew + ":");

        votesa = 0;
        votesw = 0;
        coalition_size = 0;
        for (it : bloc_map_) {
            choice = it^.rankings_[0];
            bloc_name = to_string(it^.rankings_);
            bloc_name = bloc_name + " (" + it^.size_ + ")";

            /* voters for the winner do not vote strategically. */
            if (choice == winner_) {
                println(String + " " + bloc_name + " won.");
                votesw += it^.size_;
                continue;
            }

            /* A voters have no other strategy. */
            if (choice == a) {
                println(String + " " + bloc_name + " voted for " + namea + ".");
                votesa += it^.size_;
                continue;
            }

            /* find voters who prefer A>winner. */
            for (preference : it^.rankings_) {
                if (preference == winner_) {
                    println(String + " " + bloc_name + " prefer " + namew + ">" + namea + ".");
                    continue next_bloc;
                }
                if (preference == a) {
                    println(String + " " + bloc_name + " should vote strategically.");
                    break;
                }
            }

            /* add to the coalition. */
            coalition_size += it^.size_;
        } : next_bloc;

        println(String + " votes winner     " + namew + ": " + votesw);
        println(String + " votes challenger " + namea + ": " + votesa);
        println(String + " coalition size    : " + coalition_size);
    }
}

int32 main() {

    LinPro linpro;
    linpro.run();

    return 0;
}
