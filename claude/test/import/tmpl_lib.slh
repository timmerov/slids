/*
test imported templates defined in another source file.
this is the template header file.
*/

/*
claude says:

the header is the INTERFACE: bodyless template declarations (legal only in
an imported file), class templates whose members — methods, hooks, even a
user op= — are declarations, and whole alias templates. a consumer compiles
against these alone: full layout (sizeof folds), declaration-only members,
kDeclare linkage, and a .sli demand per flavor. the definitions live in the
SAME-NAMED source, tmpl_lib.sl, whose own compile (--instantiate) emits
every demanded flavor once.
*/

/* the workhorse: fields + bodyless method declarations; the bodies live in
   tmpl_lib.sl as a RE-OPEN of this primary opening. The const and the member
   alias are whole in the header (leaf members are not stripped from a
   declare-only clone) — consumers read them instance-qualified
   (`Vector<int>:kTag`). */
Vector<T>(T data_ = 0, T extra_ = 0) {
    const int kTag = 7;
    alias Elem = T;
    /* nested ALIAS TEMPLATES: type-level, whole in the header — no bodies to
       deliver, so a header class template may carry them (unlike a nested
       class or template method). `Duo`'s target uses the OUTER T: only an
       instance-qualified use binds it. */
    alias Ptr<U> = U^;
    alias Duo<U> = (T, U);
    void push(T v);
    T sum();
}

/* lifecycle hooks declared here, defined across the seam. */
Traced<T>(T t_ = 0) {
    _();
    ~();
    T get();
}

/* a pointer field carries ANY argument type — including one declared in a
   different header. */
Box<T>(T^ p_ = nullptr) {
    int has();
}

/* a function template, declared; its definition merges in tmpl_lib.sl. */
T tsum<T>(T a, T b);

/* ARITY-ONLY template overloading across the seam: two same-name templates
   with distinct parameter counts; a demand spelling carries no arity, so the
   --instantiate pass emits every fitting sibling. */
T tpair<T>(T a);
T tpair<T>(T a, T b);

/* pointer-friendly twins: `tpick`'s body is self-contained (a local-type
   instance can inline it); `tpock`'s body leans on a tmpl_lib-PRIVATE helper,
   so only tmpl_lib's own TU can emit its flavors. Under const correctness
   (canon B, 2026-07-26) a bare-T body cannot RETURN a pointer binding (the
   munge consts the param's pointee; the return type stays mutable), so the
   POINTER demands ride `tdiff` — a read-only comparison body, legal for
   every binding. */
T tpick<T>(T a, T b);
T tpock<T>(T a, T b);
bool tdiff<T>(T a, T b);

/* like `tpock`, but the body READS a private name (a const) instead of
   calling one — the identifier flavor of the private-name diagnostic. */
T tbias<T>(T v);

/* ITERATOR-ARITHMETIC templates: explicitly-spelled `T[]` params (no bare-T
   munge), so an OPAQUE argument flavor (tstep<Rope>) makes the aggregated
   body do `ptr + n` / `b - a` in a TU where T has no layout — the stride
   must be the convention's, not the placeholder's. */
T[] tstep<T>(T[] p, intptr n);
intptr tgap<T>(T[] a, T[] b);

/* an alias template is whole in the header — nothing to defer. */
alias TRef<T> = T^;

/* a header-declared INCOMPLETE template — interface only, not even fields;
   the source's completing re-open (no trailing `...`) supplies the field
   list and the bodies. Consumers get the FULL LAYOUT: a real struct, constant
   field offsets, embeddable BY VALUE — because the completing re-open is
   TEMPLATE content, which survives the strip every importer applies to a
   loaded template source. A plain incomplete header class (library.slh's Rope)
   gets the opposite answer for the same reason: its completion is stripped. */
Grow<T>(...) {
    void add(T v);
    T total();
    intptr count();
}

/* SOURCE-PRIVATE FIELDS: the field list a header spells is the class's PUBLIC
   interface; the fields a completing re-open supplies are private to the
   template source file. `Part` publishes `pub_` and stays open; the source's
   completion appends `sec_` — a real slot in every TU's layout, but nameable
   (and initializer-mappable) only in the source's own TU. `PDer` derives from
   a flavor IN THE HEADER, appending a public field AFTER the hidden one — the
   initializer walk must skip `sec_` mid-layout. */
Part<T>(T pub_ = 0, ...) {
    T tally();
}

Part<int> : PDer(int zed_ = 0) {
    int zz();
}

/* the library-side witness: the source's own TU sees BOTH of Part's fields. */
int partpriv();

/* the INLINE-LOCAL twin of the privacy rule: a pointer-field template (the
   Box shape, so a local-type flavor can inline the bodies), its one field
   supplied by the completion. The clone's `hold_` accesses are library code
   BY POSITION even when they compile in the consumer's TU; the consumer's
   own spelling of `hold_` still rejects. */
Sack<T>(...) {
    void put(T^ v);
    int got();
}

/* a USER transfer operator declared here: it is the flavor's canonical copy,
   defined across the seam by the source's re-open. */
Acc<T>(T v_ = 0) {
    op=(Acc^ s);
    T get();
}

/* a virtual template class: the slot declared here, implemented by the source. */
VShape<T>(T s_ = 1) {
    virtual T vid();
}

/* two type parameters (a comma in the demand spelling). */
TPair<K, V>(K k_ = 0, V v_ = 0) {
    K kk();
    V vv();
}

/* a namespace-member template — `nid` is pointer-friendly, for the
   local-type path (a namespace member needs no carve-out: it follows the
   file re-home, like a free function). */
Spc2 {
    T nsq<T>(T v);
    T nid<T>(T v);
}

/* a user op= with an OBSERVABLE skew (it nulls instead of copying) — the
   canonical copy of an inline-local flavor must be the USER's, internal. */
Ucp<T>(T^ u_ = nullptr) {
    op=(Ucp^ s);
    int un();
}

/* a header-incomplete template that NO loaded opening ever completes. */
//-EXPECT-ERROR: never completed
//Ngrow<T>(...) {
//    void nadd(T v);
//}

/* a nested class inside a header class template has no body channel. */
//-EXPECT-ERROR: may not contain a nested class
//NBad<T>(T n_ = 0) {
//    Inner(int i_ = 0) {
//    }
//}

/* a template method inside a header class template stays rejected too — its
   instances aren't knowable to the source's --instantiate pass (a TU-local
   class template takes both forms; tmpl_nested.sl). */
//-EXPECT-ERROR: may not contain a template method
//MBad<T>(T m_ = 0) {
//    U tm<U>(U v);
//}

/* plain functions the SOURCE implements using templates: its own use of an
   aggregated flavor, and its use of ANOTHER library's template (tmpl_lib2) —
   the mixed-role proofs, observable from any consumer. */
int viaW2();
int viaOwn();

/* a plain header class with a TEMPLATE METHOD declaration; the body lands in
   the source via the out-of-line form. */
Gauge(int g_ = 0) {
    T scaled<T>(T v);
    T tsel<T>(T a, T b);
    int base();
}
