/*
model the electorate.
*/

import string;
import vector;

/** initialization options. **/
const int kElectorateUniform = 0;
const int kElectorateRandom = 1;
const int kElectorateClusters = 2;

Position(
    Vector<float64> axis_
) {
    /** return the utility to another position. **/
    float64 utility(Position^ other);

    /** format the position as a string. **/
    String to_string();

    /** for sorting **/
    /*bool operator < (const Position& other) const;*/
}

Voter(
    /** position along the axis ranges from 0..1 **/
    Position position_
) {
    /** for sorting **/
    //bool operator < (const Voter& other) const;
}
alias Voters = Vector<Voter>;

Cluster(...) { }
alias Clusters = Vector<Cluster>;

Electorate(
    /** configuration. **/
    int nvoters_ = 100,
    int method_ = kElectorateUniform,
    int naxes_ = 1,

    /** minor axes have reduced range (and utility). **/
    float64 axis_weight_decay_ = 1.0,
    int nclusters_ = 6,

    /** data **/
    Voters voters_
) {
    /** set configuration parameters above. required. **/
    void init();

    /** what did we get. **/
    void show_distribution();
}
