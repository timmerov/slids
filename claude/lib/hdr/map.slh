/*
key/value map.
built upon red/black tree.
*/

import tree;

TreeNode : MapNode<Key, Value>(
    Key key_,
    Value value_
) {
    _();
    ~();
}

Map<Key, Value>(...) {
    alias MapIter = MapNode<Key, Value>^;

    _(); ~();

    intptr size();
    void insert(Key key, Value value);
    void print();
}
