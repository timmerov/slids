/*
key/value map.
built upon red/black tree.
*/

import tree;

/* slids namespace */
slids {

TreeNode : MapNode<Key, Value>(
    Key key_,
    Value value_
) {
    _();
    ~();
}

Map<Key, Value>(...) {
    alias MapIter = MapNode<Key, Value>^;

    _(); ~();

    intptr size();
    MapIter begin();
    MapIter end();
    MapIter next(MapIter it);

    void clear();
    MapIter find(Key key );
    void insert(Key key, Value value);
}

} /* slids */
