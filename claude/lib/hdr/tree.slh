/*
red black tree.
*/

TreeNode(
    Color color_ = kRed,
    TreeNode^ parent_ = nullptr,
    TreeNode^ left_ = nullptr,
    TreeNode^ right_ = nullptr
) {
    enum Color (kRed, kBlack, kNull);

    _();
    ~();

    /* recolor/rebalance the tree. */
    void rebalance();
}
