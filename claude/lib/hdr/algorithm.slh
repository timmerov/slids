/*
algorithm library.
*/

/*
useful type sets for template specialization.
*/
alias SignedIntegerSet = <int|int8|int16|int32|int64>;
alias UnsignedIntegerSet = <uint|uint8|uint16|uint32|uint64>;
alias IntegerSet = <SignedIntegerSet|UnsignedIntegerSet>;
alias FloatSet = <float|float32|float64>;
alias NumberSet = <IntegerSet|FloatSet>;
alias PointerSet = <^|[]>;
alias PrimitiveSet = <bool|char|intptr|NumberSet|PointerSet>;
alias ArraySet = <[N]>;
alias TupleSet = <()>;
alias ClassSet = !<ArraySet|TupleSet|PrimitiveSet>;

/*
return the number of elements in an array.
*/
intptr countof<T=[N]>(T arg);

/*
return the size of a container class.
the class must define a size() method.
*/
intptr countof<T=ClassSet>(T arg);

/*
quicksort an array or a container class.
a container class must be index-able.
ie it must implement the index operator: op[].
the contained type must be comparable by less-than.
ie a contained class must implement op<.
*/
void quicksort<T>(mutable T container);
